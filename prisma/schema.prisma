// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Artikel / Blog Post
// ──────────────────────────────────────────────
model Article {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title   String
  slug    String @unique
  excerpt String
  content String @db.Text
  cover   String
  coverImageId String?
  coverImage   MediaImage? @relation("ArticleCover", fields: [coverImageId], references: [id])
  author   String @default("Admin Juragan")
  readTime String @default("5 menit")
  published Boolean  @default(false)
  publishedAt DateTime?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?
  canonicalUrl    String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  tags       ArticleTag[]
  @@index([slug])
  @@index([published, publishedAt])
  @@index([categoryId])
}

model GalleryItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  src     String
  alt     String
  caption String?
  imageId    String?
  mediaImage MediaImage? @relation("GalleryImage", fields: [imageId], references: [id])
  title       String?
  description String?
  sortOrder Int     @default(0)
  featured  Boolean @default(false)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  @@index([categoryId])
  @@index([featured])
  @@index([sortOrder])
}

model Category {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name        String @unique
  slug        String @unique
  type        String
  description String?
  metaTitle       String?
  metaDescription String?
  articles     Article[]
  galleryItems GalleryItem[]
  @@index([type])
  @@index([slug])
}

model Tag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name String @unique
  slug String @unique
  articles ArticleTag[]
  @@index([slug])
}

model ArticleTag {
  articleId String
  tagId     String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([articleId, tagId])
}

model Fleet {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name  String  @unique
  slug  String  @unique
  badge  String?
  image  String
  imageId     String?
  mediaImage  MediaImage? @relation("FleetImage", fields: [imageId], references: [id])
  flip       Boolean @default(false)
  imageClass String  @default("")
  sortOrder  Int     @default(0)
  description String?
  seats       Int?
  transmission String?
  year        Int?
  metaTitle       String?
  metaDescription String?
  active Boolean @default(true)
  @@index([slug])
  @@index([active, sortOrder])
}

model Testimonial {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name     String
  role     String
  content  String
  avatar   String?
  initials String
  rating   Int     @default(5)
  featured  Boolean @default(false)
  sortOrder Int     @default(0)
  @@index([featured])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("text")
  @@index([key])
}

model MediaImage {
  id        String   @id @default(cuid())
  publicId  String   @unique
  secureUrl String
  width     Int?
  height    Int?
  format    String?
  folder    String?
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  articles  Article[]     @relation("ArticleCover")
  fleets    Fleet[]       @relation("FleetImage")
  galleries GalleryItem[] @relation("GalleryImage")
}

model WaTracker {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  source    String
  message   String?  @db.Text
  ip        String?
  userAgent String?  @db.Text
  referer   String?  @db.Text
}
